{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "promise", "node", "vitest"],
  "ignorePatterns": ["coverage/**", "dist/**", "node_modules/**"],
  "settings": {
    "vitest": {
      "typecheck": true
    }
  },
  "rules": {
    "complexity": ["error", { "max": 10 }],
    "import/no-cycle": "error",
    "max-depth": ["error", { "max": 2 }],
    "max-lines": ["error", { "max": 500 }],
    "max-params": ["error", { "max": 3 }],
    "no-else-return": "error",
    "no-empty": ["error", { "allowEmptyCatch": false }],
    "no-restricted-globals": [
      "error",
      { "name": "jest", "message": "Use vitest instead of jest." }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          { "name": "jest", "message": "Use vitest." },
          { "name": "@jest/globals", "message": "Use vitest." },
          { "name": "mocha", "message": "Use vitest." },
          { "name": "chai", "message": "Use vitest." },
          { "name": "sinon", "message": "Use vitest." },
          { "name": "jasmine", "message": "Use vitest." },
          { "name": "ava", "message": "Use vitest." },
          { "name": "tape", "message": "Use vitest." },
          { "name": "node:test", "message": "Use vitest." }
        ]
      }
    ],
    "no-unused-vars": ["warn", { "ignoreRestSiblings": true }],
    "preserve-caught-error": "error",
    "typescript/await-thenable": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/prefer-readonly": "error",
    "typescript/switch-exhaustiveness-check": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.spec.ts"],
      "globals": {
        "afterAll": "readonly",
        "afterEach": "readonly",
        "beforeAll": "readonly",
        "describe": "readonly",
        "expect": "readonly",
        "it": "readonly",
        "test": "readonly",
        "vi": "readonly"
      }
    }
  ]
}
